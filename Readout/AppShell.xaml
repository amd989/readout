<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Readout.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Readout.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Readout">

    <TabBar>
        <Tab Title="Meter" Icon="tab_meter.png">
            <ShellContent ContentTemplate="{DataTemplate views:MeterPage}" Route="meter" />
        </Tab>
        <Tab Title="Sessions" Icon="tab_sessions.png">
            <ShellContent ContentTemplate="{DataTemplate views:SessionsPage}" Route="sessions" />
        </Tab>
        <Tab Title="Settings" Icon="tab_settings.png">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="settings" />
        </Tab>
    </TabBar>

</Shell>
