<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Readout.Views">

    <views:NotEmptyConverter x:Key="NotEmpty" />

    <!-- A rounded panel for grouped content. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F2EE, Dark=#23282B}" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
    </Style>

    <!-- A secondary action: outlined instead of filled. -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>

    <!-- A small text-only action, inline with other text. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource SecondaryDarkText}}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <!-- The meter's front-panel buttons. -->
    <Style x:Key="MeterKeyButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#292F33" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <!-- One line, a touch smaller on Android, so "1ms PEAK" fits a 320 dp wide phone. -->
        <Setter Property="FontSize" Value="{OnPlatform Default=13, Android=12}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="Padding" Value="2,12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#C9CCCF, Dark=#3A3F42}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#F4F4F4, Dark=#6E7376}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- MODE and SETUP are red and yellow on the meter; the app matches so they're easy to find. -->
    <Style x:Key="MeterModeButton" TargetType="Button" BasedOn="{StaticResource MeterKeyButton}">
        <Setter Property="BackgroundColor" Value="#C8372D" />
    </Style>
    <Style x:Key="MeterSetupButton" TargetType="Button" BasedOn="{StaticResource MeterKeyButton}">
        <Setter Property="BackgroundColor" Value="#F0B323" />
        <Setter Property="TextColor" Value="#1E2326" />
    </Style>

    <!-- The small label above a meter button: what it does in some modes, as printed on the meter. -->
    <Style x:Key="KeyCaption" TargetType="Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="End" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </Style>

    <!-- The small label right under a meter button: what holding it does, as printed on the meter. -->
    <Style x:Key="HoldCaption" TargetType="Label" BasedOn="{StaticResource KeyCaption}">
        <Setter Property="VerticalTextAlignment" Value="Start" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- Settings: a number field and the unit after it. A field without a unit is widened by
         the unit's width plus the gap (22), so the left edges line up. -->
    <Style x:Key="SettingsNumber" TargetType="Entry">
        <Setter Property="WidthRequest" Value="90" />
        <Setter Property="Keyboard" Value="Numeric" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
    </Style>
    <Style x:Key="SettingsUnit" TargetType="Label">
        <Setter Property="WidthRequest" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>
</ResourceDictionary>
