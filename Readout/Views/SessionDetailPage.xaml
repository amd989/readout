<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Readout.Views.SessionDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Readout.ViewModels"
    xmlns:views="clr-namespace:Readout.Views"
    x:DataType="vm:SessionDetailViewModel"
    Title="{Binding Name}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Rename" Command="{Binding RenameCommand}" />
    </ContentPage.ToolbarItems>

    <!-- The graph stays out of the scroll view, so dragging it pans the graph, not the page. -->
    <Grid RowDefinitions="Auto,Auto,*" Padding="16,8" RowSpacing="8" MaximumWidthRequest="720">
        <Label Text="{Binding Subtitle}" Style="{StaticResource SecondaryText}" />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,8">
            <VerticalStackLayout Spacing="4">
                <views:TrendView x:Name="Trend" Interactive="True" HeightRequest="240" />
                <Label Text="Pinch to zoom, drag to pan, double-tap to show everything." Style="{StaticResource SecondaryText}"
                       FontSize="12" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Readings" Style="{StaticResource SecondaryText}" /><Label Text="{Binding SamplesText}" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Duration" Style="{StaticResource SecondaryText}" /><Label Text="{Binding DurationText}" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Min" Style="{StaticResource SecondaryText}" /><Label Text="{Binding MinText}" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Max" Style="{StaticResource SecondaryText}" /><Label Text="{Binding MaxText}" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Average" Style="{StaticResource SecondaryText}" /><Label Text="{Binding AverageText}" FontSize="18" /></VerticalStackLayout></Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="Peak to peak" Style="{StaticResource SecondaryText}" /><Label Text="{Binding PeakToPeakText}" FontSize="18" /></VerticalStackLayout></Border>
                </Grid>

                <Label Text="{Binding OtherModesNote}" Style="{StaticResource SecondaryText}" IsVisible="{Binding HasOtherModes}" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Notes" FontFamily="OpenSansSemibold" />
                    <Border Style="{StaticResource Card}" Padding="8,4">
                        <Editor Text="{Binding Notes}" Placeholder="What were you measuring?" AutoSize="TextChanges" MinimumHeightRequest="80" />
                    </Border>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource QuietButton}" />
                    <Button Grid.Column="1" Text="Export CSV" Command="{Binding ExportCommand}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
