<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Readout.Views.MeterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Readout.ViewModels"
    xmlns:views="clr-namespace:Readout.Views"
    x:DataType="vm:MeterViewModel"
    Title="Readout">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Sessions" Command="{Binding OpenSessionsCommand}" />
        <ToolbarItem Text="About" Clicked="OnAboutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,12" Spacing="10" MaximumWidthRequest="720">

            <!-- Not connected: a card whose main action is Connect. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding ShowConnectCard}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="{Binding StatusText}" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding ModeName}" Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                    <Button Grid.Column="1" Text="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}" />
                </Grid>
            </Border>

            <!-- Connected: one slim line, so the meter gets the room. -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsConnected}">
                <Ellipse Fill="#4CAF50" WidthRequest="8" HeightRequest="8" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding ConnectedLine}" Style="{StaticResource SecondaryText}"
                       LineBreakMode="TailTruncation" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="Disconnect" Command="{Binding PrimaryActionCommand}" Style="{StaticResource LinkButton}" />
            </Grid>

            <!-- The LCD -->
            <GraphicsView
                x:Name="Lcd"
                HeightRequest="200"
                SemanticProperties.Description="{Binding ReadingDescription}" />

            <!-- The meter's buttons. Hold one for a long press. -->
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8"
                  IsEnabled="{Binding IsConnected}">
                <views:KeyButton Grid.Row="0" Grid.Column="0" Key="Range" Text="RANGE" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="0" Grid.Column="1" Key="Hold" Text="HOLD" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="0" Grid.Column="2" Key="Rel" Text="REL ▲" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="0" Grid.Column="3" Key="Peak" Text="PEAK ▼" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="1" Grid.Column="0" Key="Mode" Text="MODE" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="1" Grid.Column="1" Key="MinMax" Text="MIN MAX" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="1" Grid.Column="2" Key="Mem" Text="MEM" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
                <views:KeyButton Grid.Row="1" Grid.Column="3" Key="Setup" Text="SETUP" Style="{StaticResource MeterKeyButton}" KeyPressed="OnKeyPressed" />
            </Grid>
            <Label Text="Hold a button for a long press." Style="{StaticResource SecondaryText}" HorizontalOptions="Center" />

            <!-- Log and graph -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Trend" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="Full screen" Command="{Binding OpenGraphCommand}" Style="{StaticResource LinkButton}" />
                    </Grid>
                    <views:TrendView x:Name="Trend" HeightRequest="170">
                        <views:TrendView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenGraphCommand}" />
                        </views:TrendView.GestureRecognizers>
                    </views:TrendView>
                    <Label Text="{Binding Statistics}" Style="{StaticResource SecondaryText}" />
                    <Label Text="{Binding LogSummary}" Style="{StaticResource SecondaryText}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="{Binding LoggingActionText}" Command="{Binding ToggleLoggingCommand}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="1" Text="Clear" Command="{Binding ClearLogCommand}" IsEnabled="{Binding HasLog}" Style="{StaticResource QuietButton}" />
                        <Button Grid.Column="2" Text="Save" Command="{Binding SaveSessionCommand}" IsEnabled="{Binding HasLog}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
