<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Readout.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Readout.ViewModels"
    x:DataType="vm:SessionsViewModel"
    Shell.NavBarIsVisible="{OnPlatform Default=True, WinUI=False}"
    Title="Sessions">

    <Grid Padding="16,8" MaximumWidthRequest="720">
        <!-- Rows are tap targets, not selections (selection can stick on iOS). -->
        <CollectionView ItemsSource="{Binding Sessions}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout Margin="0,40" Spacing="6">
                    <Label Text="No saved sessions yet" HorizontalOptions="Center" FontFamily="OpenSansSemibold" />
                    <Label Text="Tap Save under the trend graph to keep a recording here." Style="{StaticResource SecondaryText}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionItem">
                    <Border Style="{StaticResource Card}" Margin="0,4">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:SessionsViewModel}}, x:DataType=vm:SessionsViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="1" Text="{Binding When}" Style="{StaticResource SecondaryText}" />
                            </Grid>
                            <Label Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
