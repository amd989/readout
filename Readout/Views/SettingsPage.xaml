<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    SafeAreaEdges="Container"
    x:Class="Readout.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Readout.ViewModels"
    x:DataType="vm:SettingsViewModel"
    Shell.NavBarIsVisible="{OnPlatform Default=True, WinUI=False}"
    Title="Settings">

    <ScrollView SafeAreaEdges="None">
        <VerticalStackLayout Padding="16,8,16,24" Spacing="8" MaximumWidthRequest="720">

            <Label Text="CONNECTION" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout VerticalOptions="Center">
                        <Label Text="Reconnect by itself" />
                        <Label Text="To the last meter, at launch and when it comes back in range." Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AutoReconnect}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <Label Text="CONTINUITY" Style="{StaticResource SectionHeader}" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Beep" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ContinuitySound}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowVibration}">
                        <Label Text="Vibrate" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ContinuityVibration}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Label Text="On below" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding OnBelow}" Style="{StaticResource SettingsNumber}" />
                        <Label Grid.Column="2" Text="Ω" Style="{StaticResource SettingsUnit}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Label Text="Off above" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding OffAbove}" Style="{StaticResource SettingsNumber}" />
                        <Label Grid.Column="2" Text="Ω" Style="{StaticResource SettingsUnit}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ContinuityHelp}" Style="{StaticResource SecondaryText}" />

            <!-- Mac and Windows: let an AI assistant such as Claude use the meter over MCP. -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowMcp}">
                <Label Text="AI ASSISTANTS" Style="{StaticResource SectionHeader}" Margin="0,12,0,0" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Let AI assistants use the meter" />
                                <Label Text="{Binding McpStatus}" Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding McpEnabled}" VerticalOptions="Center" />
                        </Grid>
                        <!-- As wide as a number field, the gap and its unit (90 + 6 + 16), so it starts
                             where the Ω fields do and ends at the card's edge. -->
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Port" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Text="{Binding McpPort}" Style="{StaticResource SettingsNumber}" WidthRequest="112" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Address" />
                                <Label Text="{Binding McpAddress}" Style="{StaticResource SecondaryText}" LineBreakMode="MiddleTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Copy" Command="{Binding CopyMcpAddressCommand}" Style="{StaticResource QuietButton}" VerticalOptions="Center" WidthRequest="96" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Header" />
                                <!-- The token stays hidden; Copy gives the real header. -->
                                <Label Text="Authorization: Bearer ••••••••" Style="{StaticResource SecondaryText}" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Copy" Command="{Binding CopyMcpHeaderCommand}" Style="{StaticResource QuietButton}" VerticalOptions="Center" WidthRequest="96" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Token" />
                                <Label Text="Assistants need it to connect. Replace it to cut off ones you've set up." Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Replace" Command="{Binding NewMcpTokenCommand}" Style="{StaticResource QuietButton}" VerticalOptions="Center" WidthRequest="96" />
                        </Grid>
                        <Button Text="Copy setup for…" Command="{Binding CopyMcpSetupCommand}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="Runs a Model Context Protocol (MCP) server on this computer, so an assistant such as Claude can read the meter, see recent readings, press its buttons and save sessions. Only programs on this computer that have the token can use it. Copy setup for… has ready-made setups for Claude Code, Claude Desktop, VS Code and Cursor; other MCP clients need the address and the header."
                       Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>

            <Label Text="ABOUT" Style="{StaticResource SectionHeader}" Margin="0,12,0,0" />
            <Border Style="{StaticResource Card}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="About Readout" />
                        <Label Text="{Binding Version, StringFormat='Version {0}'}" Style="{StaticResource SecondaryText}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="22" VerticalOptions="Center" Style="{StaticResource SecondaryText}" />
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
