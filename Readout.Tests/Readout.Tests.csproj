<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<OutputType>Exe</OutputType>
		<IsPackable>false</IsPackable>
		<RootNamespace>Readout.Tests</RootNamespace>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- The fakes complete synchronously, so threading the test token through adds nothing. -->
		<NoWarn>$(NoWarn);xUnit1051</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Readout.Core\Readout.Core.csproj" />
		<ProjectReference Include="..\Readout.Mcp\Readout.Mcp.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- FakeTimeProvider: the simulated meter's clock stands still unless a test moves it. -->
		<PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
		<PackageReference Include="xunit.v3" Version="4.0.1" />
	</ItemGroup>

</Project>
